{
    "name": "hansdeboeck/hansui",
    "description": "HansUI: de gedeelde interface van de Laravel-applicaties van deboeck.dev. Semantische tokens, een componentlaag, Blade-componenten en de data-attribuuthelpers.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "blade",
        "tailwind",
        "design-system"
    ],
    "authors": [
        {
            "name": "Hans De Boeck",
            "email": "hans@deboeck.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "HansDeBoeck\\HansUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HansDeBoeck\\HansUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HansDeBoeck\\HansUi\\HansUiServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
